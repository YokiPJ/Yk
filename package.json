{
  "name": "hinaria-project",
  "version": "1.3.0-beta.4",
  "private": true,
  "description": "Projeto HINÁRIA completo: jogo, Android, modelos e laboratórios de animação",
  "scripts": {
    "setup": "npm --prefix hinaria ci && node hinaria/tools/prepare-runtime.mjs hinaria/vendor",
    "start": "npm --prefix hinaria run studio",
    "game": "npm --prefix hinaria start",
    "build": "npm --prefix hinaria run build:web",
    "build:studio": "npm --prefix hinaria run build:studio",
    "build:animations": "npm --prefix hinaria run build:animations",
    "build:android": "npm --prefix hinaria run android:debug",
    "verify": "npm --prefix hinaria run verify",
    "test:studio": "npm --prefix hinaria run test:studio",
    "test:browser": "npm --prefix hinaria run test:browser --",
    "build:mobile": "npm --prefix hinaria run build:mobile",
    "release:prepare": "python3 hinaria/tools/prepare-release.py",
    "test:mobile": "npm --prefix hinaria run test:mobile"
  },
  "engines": {
    "node": ">=22"
  }
}
