{
  "name": "hinaria-v7-android",
  "version": "1.3.0-beta.2",
  "private": true,
  "type": "module",
  "description": "HINÁRIA RPG — título cinematográfico, HUD acessível, pausa e save completo offline",
  "scripts": {
    "build:web": "node tools/build-web.mjs",
    "android:add": "npm run build:mobile && npx cap add android",
    "android:sync": "npm run build:mobile && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android",
    "android:debug": "npm run android:sync && node tools/assemble-debug.mjs",
    "test:package": "node tools/test-package.mjs",
    "test:qa": "node tools/run-qa.mjs",
    "start": "node server.js",
    "serve:offline": "node server.js --offline",
    "test:browser": "node tools/test-upgrade-browser.mjs",
    "studio": "node server.js --studio",
    "build:studio": "python3 tools/build-studio.py",
    "build:animations": "node tools/build-motion-java.mjs && npm run build:studio",
    "test:studio": "npm run build:studio && node tools/test-studio.mjs",
    "test:integration": "node tools/test-studio-integration.mjs",
    "verify": "npm run test:qa && npm run test:imports && npm run test:package && npm run test:integration",
    "test:animations": "python3 tools/motion-java/tools/verify-data.py && node tools/motion-java/tools/validate-glb.mjs",
    "test:imports": "node tools/check-imports.mjs && node tools/verify-release.mjs",
    "build:mobile": "node tools/build-web.mjs --game-only",
    "benchmark:mobile": "node tools/benchmark-mobile.mjs",
    "test:mobile": "node tools/test-mobile-browser.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "animejs": "3.2.1",
    "esbuild": "0.25.12",
    "fflate": "0.8.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "pixi.js": "8.6.6",
    "playwright": "^1.64.1",
    "three": "0.160.0"
  },
  "engines": {
    "node": ">=22"
  }
}
